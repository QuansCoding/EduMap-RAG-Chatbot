# This is a .env EXAMPLE

# --- Database (Supabase → Connect → Session pooler) ---
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://PROJECTREF.supabase.co

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Limits ---
DAILY_CHAT_LIMIT=40
DAILY_UPLOAD_LIMIT=10
DAILY_ROADMAP_LIMIT=5
GLOBAL_DAILY_AI_LIMIT=400
DEMO_EMAIL=demo@edumap.app
DEMO_DAILY_LIMIT=10

# --- Only needed by scripts/get_token.py ---
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx